# Local demo defaults. Copy to .env for real keys. Never commit .env.

# sqlite:///./information_hunters.db  or  postgresql+psycopg://hunter:hunter@localhost:5432/information_hunters
DATABASE_URL=sqlite:///./information_hunters.db

# Token the Next.js server sends to the Python API. Not a user password.
INTERNAL_API_TOKEN=dev-internal-token

# When true, hunts use the synthetic catalogue unless a provider is chosen explicitly.
DEMO_MODE=true

# Encrypts API keys saved from the Settings page. Derive-friendly passphrase is fine.
SECRETS_MASTER_KEY=dev-master-key-change-me

# Optional live providers. Leave blank to stay in demo mode.
COMPANIES_HOUSE_API_KEY=
GOOGLE_PLACES_API_KEY=
SCRAPINGBEE_API_KEY=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=
APIFY_TOKEN=
APIFY_ACTOR_ID=

# direct | scrapingbee | brightdata | playwright | none | auto
CONTACT_FETCHER=auto

# Web (also mirrored in web/.env.development for `npm run dev`)
DEMO_PASSWORD=hunter-demo
AUTH_SECRET=dev-auth-secret-change-me
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_HINT=true
# Set true only behind HTTPS.
COOKIE_SECURE=false
