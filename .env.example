# Local demo defaults. Copy to .env for real keys. Never commit .env.

# Local SQLite, or Supabase/Neon Postgres so the cloud worker shares the same data.
# Supabase (IPv4 session pooler — required on Windows; direct db.*.supabase.co is IPv6-only):
# postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./information_hunters.db

# When true, hunts use the synthetic catalogue unless a provider is chosen explicitly.
DEMO_MODE=true

# Encrypts API keys saved from the Settings page. Derive-friendly passphrase is fine.
SECRETS_MASTER_KEY=dev-master-key-change-me

# Optional live providers. Leave blank to stay in demo mode.
COMPANIES_HOUSE_API_KEY=
GOOGLE_PLACES_API_KEY=
SCRAPINGBEE_API_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=

# direct | scrapingbee | playwright | none | auto
CONTACT_FETCHER=auto

# Web (also mirrored in web/.env.development for `npm run dev`)
API_INTERNAL_URL=http://127.0.0.1:8000

# Optional: Start / Stop cloud worker from the Scrapers page (GitHub PAT with Actions: write)
# GITHUB_TOKEN=
# GITHUB_REPO=Abdullah-Shakil/Information-Hunters
# GITHUB_WORKFLOW=cloud-worker.yml
# GITHUB_REF=main
