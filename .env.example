# Local demo defaults. Copy to .env for real keys. Never commit .env.

# Local SQLite, or Supabase/Neon Postgres so a cloud worker shares the same data.
# Supabase (IPv4 session pooler — required on some networks; direct db.*.supabase.co is often IPv6-only):
# postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_URL wins over DATABASE_URL when both are set. postgresql:// is rewritten to postgresql+psycopg://.
DATABASE_URL=sqlite:///./information_hunters.db
SUPABASE_DB_URL=
# Control-site connection test only. Workers use the database URL above, not these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# When true, hunts use the synthetic catalogue unless a provider is chosen explicitly.
DEMO_MODE=true

# Encrypts API keys saved from the Settings and Hosts pages. Every worker that reads those keys needs the same value.
SECRETS_MASTER_KEY=dev-master-key-change-me

# Shared secret between the Next.js server and the Python API. The desk has no password page;
# this token is what stops the API being open to anything that can reach it.
INTERNAL_API_TOKEN=dev-internal-token

# Optional live providers. Leave blank to stay in demo mode.
COMPANIES_HOUSE_API_KEY=
GOOGLE_PLACES_API_KEY=
SCRAPINGBEE_API_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=

# direct | scrapingbee | brightdata | playwright | none | auto
CONTACT_FETCHER=auto

# Optional label written on activity and performance rows (github_actions, oracle_cloud, apify, ...).
HOST_ID=

# Optional bearer for POST /tick. When empty, the tick endpoint requires INTERNAL_API_TOKEN instead.
WORKER_TOKEN=

# Web server. Next reads INTERNAL_API_TOKEN from the environment (same value as above) and sends it to the API.
API_INTERNAL_URL=http://127.0.0.1:8000

# Optional env fallback for the GitHub Actions host (also pasteable on Hosts, stored encrypted).
# GITHUB_REPO is owner/name. The Hosts page stores owner and repo name separately.
# GITHUB_TOKEN=
# GITHUB_REPO=Abdullah-Shakil/Information-Hunters
# GITHUB_WORKFLOW=cloud-worker.yml
# GITHUB_REF=main
